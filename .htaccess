Options -Indexes
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

RewriteEngine On

# Règle globale : redirige n'importe quelle URL sans extension vers son équivalent .php
# (uniquement si le fichier .php existe physiquement et que ce n'est pas un dossier)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
# Fichiers de configuration / secrets jamais servis (le projet entier est monté dans le webroot)
<FilesMatch "^(\.env.*|Dockerfile|docker-compose\.yml|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
