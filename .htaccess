Options -Indexes
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

RewriteEngine On

# Règle globale : redirige n'importe quelle URL sans extension vers son équivalent .php
# (uniquement si le fichier .php existe physiquement et que ce n'est pas un dossier)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]